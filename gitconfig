[url "git@github.com:"]
    insteadOf = "https://github.com/"
[core]
    autocrlf = input
[init]
    defaultBranch = main
[commit]
    gpgsign = true
[gpg]
    format = ssh
[gpg "ssh"]
    # __OP_SSH_SIGN__ is replaced by install.sh per OS
    program = "__OP_SSH_SIGN__"
[push]
    autoSetupRemote = true
[pull]
    rebase = true
[color]
    ui = auto
[filter "lfs"]
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true
    clean = git-lfs clean -- %f

# Work profile overrides
[includeIf "gitdir:~/adversarial/"]
    path = ~/adversarial/.gitconfig

# Machine-specific settings (not tracked, create manually)
[include]
    path = ~/.gitconfig-local
